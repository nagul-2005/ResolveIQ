# ResolveIQ Backend Environment Configuration Example
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ResolveIQ-ITSD

# FastEmbed Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Weaviate Cloud Vector Store
WEAVIATE_URL=https://your-weaviate-instance.aws.weaviate.cloud
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Atlassian Jira Cloud Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=ITSD

# Database / Checkpointer
DATABASE_URL=sqlite+aiosqlite:///./resolveiq.db

# App Settings
PORT=8000
HOST=0.0.0.0
